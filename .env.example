# Webbles Fix — секреты окружения.
# Скопируйте этот файл в `.env` (рядом, без `.example`) и подставьте свои значения.
# `.env` уже в .gitignore — он НЕ попадёт в коммит.

# Основной LLM-ключ (DeepSeek / OpenAI / Anthropic — в зависимости от provider в webles_config.json)
WEBBLES_LLM_API_KEY=sk-replace-me

# Доп. ключи того же провайдера для pipeline.parallel_workers>1 (через
# запятую) — каждый параллельный поток получает свой ключ и свой
# изолированный circuit breaker вместо общего на все потоки (round-robin
# по индексу файла, см. fixers/llm_client.py:build_llm_client_pool).
# Не обязательно: без этой переменной все потоки используют один
# WEBBLES_LLM_API_KEY.
WEBBLES_LLM_API_KEY_POOL=

# Telegram-уведомления (опционально)
WEBBLES_TELEGRAM_TOKEN=
WEBBLES_TELEGRAM_CHAT_ID=

# Если у вас boevoy ключ всё ещё лежит в webles_config.json / webles_secrets.json —
# рекомендация: ротировать ключ у провайдера, прописать новый в .env,
# а в webles_config.json оставить "api_key": null.
